# Salin ke .env.local untuk vercel dev, dan isi di Vercel: Project Settings > Environment Variables
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER=admin
ADMIN_PASS=
# Minimal 32 karakter acak. Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Hanya untuk npm run migrate (lokal). Supabase: Project Settings > Database > Connection string (URI), ganti [YOUR-PASSWORD].
# Jangan diisi di Vercel, fungsi API tidak memakainya.
DATABASE_URL=
